# Hugging Face token with Inference Providers permission.
# https://huggingface.co/settings/tokens
# Tokens stay on the server. Never use a REACT_APP_ variable for a token.
HF_API_KEY=
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
# Inference availability depends on the account's remaining provider credits.
# Without a usable key/credits, supported queries use an explicitly labelled fallback.
PORT=5001
# For deployment, point DATABASE_PATH and BUILDINGS_CACHE_PATH at persistent storage.
# DATABASE_PATH=/app/data/dashboard.db
# BUILDINGS_CACHE_PATH=/app/data/buildings.json
BUILDINGS_CACHE_TTL=3600
# Only needed when running the frontend on a separate origin.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
